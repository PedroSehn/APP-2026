        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "7acecfea-0163-4973-b478-d3de1e5a5a8e",
                "exec": [
                  "// Supondo que o response venha assim: { \"token\": \"jwt_aqui\" }\r",
                  "const res = pm.response.json();\r",
                  "\r",
                "// Salva o token no ambiente\r",
                "pm.environment.set(\"JWT_TOKEN\", res.token);\r",
                "if (res.refreshToken) {\r",
                "  pm.environment.set(\"REFRESH_TOKEN\", res.refreshToken);\r",
                "}\r",
                  "\r",
                  "// (Opcional) teste de status\r",
                  "pm.test(\"Login 200\", () => {\r",
                  "  pm.response.to.have.status(200);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
